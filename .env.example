# In OMV im Feld "Environment" (.env) einfügen und anpassen.
# Token erzeugen, z. B. auf dem Server: openssl rand -hex 32
# Nur a-z, A-Z, 0-9 verwenden: Umlaute oder Sonderzeichen sendet der Browser
# anders als der Server sie speichert, dann wird der Token abgelehnt.
RUVIEW_API_TOKEN=hier-einen-langen-zufaelligen-wert-eintragen
# IP-Adresse deines OMV-Servers im Heimnetz
SERVER_IP=192.168.1.10
# Port, unter dem RuView am Server erreichbar ist (3000 ist oft belegt)
RUVIEW_PORT=3080
# Port der eigenen Demo "Wer ist wo"
DEMO_PORT=3090
# Dein Heimnetz (für den ESP32 ab Schritt 2)
LAN_SUBNET=192.168.1.0/24
CSI_SOURCE=simulated
